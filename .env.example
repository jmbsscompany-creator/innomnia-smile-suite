# Plantilla. Copia este archivo como .env.local y pon los valores reales.
# .env.local NO se sube a GitHub (git lo ignora).
#
# Los dos valores salen de: Supabase -> Settings -> API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# NUNCA pongas aqui la clave service_role.
# Esa se salta todos los candados de seguridad y no debe vivir
# en el navegador ni en el codigo.
